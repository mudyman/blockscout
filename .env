# ... 已有的 DATABASE_URL 和 SECRET_KEY_BASE

# --- 区块链连接设置 ---
# 区块链JSON-RPC变体，通常设置为 ethereum
export ETHEREUM_JSONRPC_VARIANT=geth

# 你要连接的区块链节点JSON-RPC HTTP URL
# !!! 替换为你的实际节点URL !!!
# 示例 (连接到Sepolia测试网的公共节点，或者你自己的本地/远程节点)
export ETHEREUM_JSONRPC_HTTP_URL=http://192.168.0.44:8545
# 如果你的RPC节点需要API密钥，可以在这里添加，否则留空
export ETHEREUM_JSONRPC_WS_URL=ws://localhost:8546
# ETHEREUM_JSONRPC_TRACE_URL=http://localhost:8545
# ETHEREUM_JSONRPC_API_KEY=your_api_key_here

# --- Blockscout 应用设置 ---
# 是否启用API V2，通常启用
export API_V2_ENABLED=true

# Blockscout 后端将监听的端口
export PORT=4000 # 默认为4000，与前端默认端口3000不同

# 区块链原生代币符号 (例如 ETH, BNB, ETC)
export COIN=QTH

# 区块链原生代币名称 (例如 Ethereum, Binance Coin, Ethereum Classic)
export COIN_NAME=QEthereum

# 是否显示代币图标
export DISPLAY_TOKEN_ICONS=true

# 是否启用 Ecto.Adapters.SQL.Sandbox
# 生产环境应为 false，开发环境可以为 true
export ECTO_USE_SANDBOX=false

# 如果需要强制 HTTPS (生产环境通常需要)
# FORCE_SSL=true

# CORS 允许的来源 (前端地址)
# CORS_ORIGIN=http://localhost:3000

# 如果有多个实例，可以设置实例名称
# INSTANCE_NAME=My Sepolia Explorer
